{
  "name": "flipper-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ts-node-dev src/server.ts",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "build": "tsc",
    "setup": "cross-env NODE_ENV=development ts-node src/setup-database.ts",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "cross-env NODE_ENV=development ts-node src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push:pg",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "lint:security": "eslint src --ext .ts --config .eslintrc.js --no-eslintrc --env node",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bip32": "^2.0.6",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.6",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.29.5",
    "ethereumjs-wallet": "^1.0.2",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "otplib": "^12.0.1",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "resedit": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@typescript-eslint/utils": "^8.45.0",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.20.4",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "tailwindcss": "^4.1.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
