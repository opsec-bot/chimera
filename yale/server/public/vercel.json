{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "claim-portal",
  "builds": [
    {
      "src": "frame.html",
      "use": "@vercel/static"
    },
    {
      "src": "frame.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/frame.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}